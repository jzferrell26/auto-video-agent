{
  "name": "auto-video-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Student-friendly local video workflows with configurable branding and captions.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "demo": "node scripts/render-demo.mjs",
    "demo:media": "node scripts/prepare-demo.mjs",
    "compositions": "remotion compositions src/index.tsx",
    "build": "remotion bundle src/index.tsx build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "docs": "node engine/pipeline/gen-docs.mjs",
    "docs:check": "node engine/pipeline/gen-docs.mjs --check",
    "check": "npm run typecheck && npm run docs:check && npm test && npm run check:hygiene",
    "render:platforms": "node engine/pipeline/render-platforms.mjs",
    "build:lessons": "node engine/pipeline/build-lessons.mjs",
    "deliver:ghl": "node engine/pipeline/ghl-publish-complete.mjs",
    "render:job": "node engine/pipeline/render-job.mjs",
    "pii:scan": "node engine/pipeline/pii-scan.mjs",
    "redact": "node engine/pipeline/redact.mjs",
    "master:audio": "node engine/pipeline/master-audio.mjs",
    "archive": "node engine/pipeline/archive.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

# Copy to .env and fill in only what you use: the GoHighLevel delivery adapter, the
# optional archive command, or the optional clone-video module.
# Never commit your real .env (it is gitignored).

# Your GoHighLevel sub-account (location) id.
GHL_LOCATION_ID=

# A GoHighLevel Private Integration Token for that sub-account, with the
# courses.write and medias.write scopes. Create it in the sub-account under
# Settings -> Private Integrations.
GHL_PIT=

# Optional. A cloud-synced folder, for example a Google Drive for desktop folder, where
# `npm run archive` moves finished videos. Use an absolute path. Leave empty to disable.
VIDEO_ARCHIVE_DIR=

# Only needed for the optional clone-video module (docs/clone-video.md).
# A HeyGen API key from your own HeyGen account. Never commit a real key.
HEYGEN_API_KEY=
